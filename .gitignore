# ========================================================
# Git Ignore for Call of Cthulhu 7e Investigator Codex
# ========================================================

# Local Reference Materials & Rulebooks (Heavy binary / Copyrighted PDFs)
references/
archive/
*.pdf

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.env
venv/
.venv/

# Personal veteran sheet dumps & test sheets
user_veteran_sheet.xlsx
sheet.xlsx
sheet2.xlsx
sheet3.xlsx

# Editor & IDE configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS-specific temporary files
Thumbs.db
Desktop.ini
.DS_Store
*.tmp
*.bak

# SolidStart & Vite build artifacts
dist/
.output/
.vinxi/
node_modules/
.wrangler/
.vercel/
.netlify/
